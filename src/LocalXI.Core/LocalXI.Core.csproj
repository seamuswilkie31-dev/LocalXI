<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LocalXI.Core</RootNamespace>
    <!-- Needed by the LibraryImport source generator for the console-signal P/Invokes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pinned list of everything the launcher downloads. Lives at the repo root so it is easy to find and bump. -->
    <EmbeddedResource Include="..\..\components.json" LogicalName="components.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <!-- Reading Windows' optional features (DirectPlay) and the Application event log (game crashes) without admin rights. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LocalXI.Core.Tests" />
  </ItemGroup>

</Project>
