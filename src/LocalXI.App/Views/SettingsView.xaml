<UserControl x:Class="LocalXI.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveCommand}" VerticalAlignment="Center" />
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0" />
            </DockPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Game folder" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseGameFolderCommand}" Margin="10,0,0,0" />
                        <TextBox Text="{Binding FfxiPath, UpdateSourceTrigger=LostFocus}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding GameChecks}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2" TextWrapping="Wrap">
                                    <Run Text="{Binding Passed, Mode=OneWay, Converter={StaticResource CheckMark}}" Foreground="{Binding Passed, Converter={StaticResource CheckBrush}}" FontWeight="Bold" />
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="-" Foreground="{StaticResource SubtleTextBrush}" />
                                    <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource SubtleTextBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RegistryStatus}" TextWrapping="Wrap" Margin="0,10,0,6" />
                    <Button Content="Fix registry" Command="{Binding FixRegistryCommand}" HorizontalAlignment="Left"
                            Visibility="{Binding RegistryOk, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource SectionTitle}" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Width" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Width}" Width="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Height" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Height}" Width="100" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Window" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}" Width="220">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,8">
                            <TextBlock Text="Interface size" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding UiScales}" SelectedItem="{Binding UiScale}" Width="120">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0}%'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding UiScaleHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <CheckBox Content="Start the game through Ashita (addons and the window settings above)" IsChecked="{Binding UseAshita}" Margin="0,4,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0"
                               Text="If the game freezes after a Square Enix update, turn this off until LocalXI ships a newer Ashita. The game then starts through xiloader alone and uses its own settings from the FINAL FANTASY XI Config tool." />
                    <CheckBox Content="Let the Windows key work while the game is open" IsChecked="{Binding WindowsKey}" Margin="0,10,0,2"
                              IsEnabled="{Binding UseAshita}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" TextWrapping="Wrap"
                               Text="The game blocks the Windows key. With this on, the Start menu and shortcuts work, such as Windows+Shift+Left/Right to move the game window to another monitor. Needs the game started through Ashita; takes effect the next time you press Play." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Controller" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Set up my controller here" IsChecked="{Binding GamepadManaged}" IsEnabled="{Binding UseAshita}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="28,2,0,8"
                               Text="Off leaves the controller to FINAL FANTASY XI's own Gamepad Config tool. On, LocalXI sets the game's controller settings each time it starts the game (through Ashita)." />
                    <Button Content="Open the game's Gamepad Config tool" Command="{Binding OpenGamepadConfigToolCommand}" HorizontalAlignment="Left" Margin="28,0,0,8"
                            Visibility="{Binding GamepadManaged, Converter={StaticResource InverseBoolToVisibility}}" />

                    <StackPanel Visibility="{Binding GamepadManaged, Converter={StaticResource BoolToVisibility}}" Margin="28,0,0,0">
                        <CheckBox Content="Use a controller" IsChecked="{Binding GamepadEnabled}" Margin="0,0,0,8" />
                        <StackPanel IsEnabled="{Binding GamepadEnabled}">
                            <TextBlock Text="Controller" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Controllers}" SelectedItem="{Binding SelectedController}" DisplayMemberPath="Label" Width="340" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding ControllerHint}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <CheckBox Content="It's connected through Steam Input or DS4Windows" IsChecked="{Binding ThroughSteamInput}" Margin="0,0,0,6"
                                      Visibility="{Binding IsPlayStation, Converter={StaticResource BoolToVisibility}}" />
                            <CheckBox Content="Confirm with the right face button, cancel with the bottom one (Nintendo and Japanese layout)" IsChecked="{Binding ConfirmOnRight}" Margin="0,0,0,6" />
                            <CheckBox Content="Vibration" IsChecked="{Binding Vibration}" Margin="0,0,0,6" />
                            <CheckBox Content="Invert the camera's up and down" IsChecked="{Binding InvertCamera}" Margin="0,0,0,6" />
                            <CheckBox Content="Keep working while the game window isn't in front" IsChecked="{Binding GamepadInBackground}" Margin="0,0,0,8" />

                            <Expander Header="Change buttons" Margin="0,0,0,4">
                                <StackPanel Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding ButtonRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="340" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Width="200" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Reset to the controller's layout" Command="{Binding ResetButtonsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="The left stick moves, the right stick turns the camera and the D-pad moves through menus and targets. The chat keyboard and macro palettes work as in the game's own controller guide." />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Takes effect the next time you press Play. If you play without a controller, untick Use a controller: that also stops a small stutter some PCs get while the game looks for one." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding RunsLocalServer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Server" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Game era" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Eras}" SelectedItem="{Binding Era}" Width="380" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EraDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12"
                               Text="Classic plays like the level-75 days: Zilart, Promathia, Aht Urhgan and Wings of the Goddess, with old-style rules. Modern is today's game. Switching reloads the game data the next time you press Play; characters are kept and backed up first." />
                    <CheckBox Content="Modern era: load zones on demand (faster start, less memory)" IsChecked="{Binding LazyZones}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,8"
                               Text="Classic always loads every zone at start-up, because many classic rules live in zone scripts." />
                    <CheckBox Content="Stop the server when I close the game (it keeps running while friends are online)" IsChecked="{Binding StopWhenGameCloses}" Margin="0,0,0,6" />
                    <CheckBox Content="Allow older game versions to log in (may cause visual glitches)" IsChecked="{Binding AllowOlderClients}" />
                    <CheckBox Content="Low memory mode: load zones only when someone enters them" IsChecked="{Binding LowMemory}" Margin="0,10,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,0,0,0" TextWrapping="Wrap"
                               Text="For PCs with 8 GB of memory or less. The world server then starts at about 120 MB instead of nearly 3 GB, growing a little as players visit zones. The catch, in classic mode: the old-style rules kept in zone scripts (some notorious monster timers, shop stock and fame checks) don't apply, because those zones aren't loaded when the rules are. Modern worlds already load zones this way." />

                    <TextBlock Text="Your world" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Server name (up to 15 letters)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaxServerNameLength}" Width="220" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Movement speed" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}" DisplayMemberPath="Label" Width="170" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Sub job level" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SubJobRatios}" SelectedItem="{Binding SelectedSubJobRatio}" DisplayMemberPath="Label" Width="330" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Welcome message (shown in chat after logging in)" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding WelcomeMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxLength="400" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Leave the name or message empty for LandSandBoat's own. Movement speed applies to every player (speed gear and Flee still add to it). Sub job level sets how high a support job can reach against the main job, for every player. All of these apply the next time the server starts." />

                    <TextBlock Text="Seasonal events" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding EventRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="190"
                                              ItemsSource="{Binding DataContext.EventModes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Selected}" DisplayMemberPath="Label" />
                                    <TextBlock Grid.Column="2" Text="{Binding Dates, StringFormat='Usually {0}'}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Always on runs an event all year: the decorations, event NPCs and their rewards appear the next time the server starts. Dates follow Japan time, as on retail. These are the seasonal events LandSandBoat has built; other holidays aren't in the server yet." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="LocalXI only downloads newer versions of these when you install a newer LocalXI that ships them. Addons update only when you press Check for updates on the Addons page, and each can be kept at its version there." />
                    <CheckBox Content="Keep my current server (LandSandBoat) when LocalXI ships a newer one" IsChecked="{Binding HoldServerUpdates}" Margin="0,0,0,6"
                              Visibility="{Binding RunsLocalServer, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Content="Keep my current Ashita and xiloader when LocalXI ships newer ones" IsChecked="{Binding HoldClientUpdates}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding HeldBackSummary}" Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Visibility="{Binding HeldBackSummary, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Keeping old versions can stop things working: a newer LocalXI may expect the newer server, and after a Square Enix update the game often needs a newer Ashita and xiloader. Friends joining your world need a matching game version either way." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding RunsLocalServer, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Backups" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="Back up characters automatically when the server stops" IsChecked="{Binding BackupOnGameExit}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Keep the newest" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding BackupsToKeep}" Width="70" />
                        <TextBlock Text="automatic backups" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Account" Style="{StaticResource SectionTitle}" />
                    <TextBlock Margin="0,0,0,8">
                        <Run Text="Logged in as" Foreground="{StaticResource SubtleTextBrush}" />
                        <Run Text="{Binding Username, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                        <Button Content="Change password" Command="{Binding ChangePasswordCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Setup &amp; folders" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Launcher data:" />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="Saves, backups and screenshots:" />
                        <Run Text="{Binding UserFolder, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel>
                        <Button Content="Run setup again" Command="{Binding RerunSetupCommand}" Margin="0,0,10,8" />
                        <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,10,8" />
                        <Button Content="Open saves folder" Command="{Binding OpenUserFolderCommand}" Margin="0,0,10,8" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Expander Header="Developer options" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="Use a local LandSandBoat build" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Point this at a LandSandBoat folder you built yourself (it must contain xi_map.exe, sql and scripts). Leave empty to use the downloaded server." />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseOverrideCommand}" Margin="10,0,0,0" />
                            <TextBox Text="{Binding OverrideDirectory}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <TextBlock Text="{Binding Version}" Style="{StaticResource Hint}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="LocalXI uses LandSandBoat (GPL-3.0), Ashita (GPL-3.0), xiloader (GPL-3.0) and MariaDB (GPL-2.0). FINAL FANTASY is a registered trademark of Square Enix. LocalXI is not affiliated with or endorsed by Square Enix, and includes none of its game files." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
